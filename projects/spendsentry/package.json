{
  "name": "spendsentry",
  "version": "0.1.0",
  "description": "Local-first CLI that watches your own Claude Code usage logs and warns you before you blow your budget. No backend, no network calls, no other vendors' tokens.",
  "type": "commonjs",
  "bin": {
    "spendsentry": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "cli",
    "cost",
    "budget",
    "token-usage"
  ],
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.10"
  }
}
